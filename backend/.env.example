# Local dev uses the Dockerized Postgres. In production (Neon) the URL needs ?sslmode=require.
DATABASE_URL="postgresql://liftkit:liftkit@localhost:5433/liftkit?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
AI_MODE="fake"
# Production only: the dashboard origin allowed by CORS (comma-separated for more than one).
# Leave unset locally to reflect any origin.
FRONTEND_URL=""